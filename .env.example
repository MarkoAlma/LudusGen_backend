# Firebase Admin (Backend)
# Get these from Firebase Console -> Project Settings -> Service Accounts
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-service-account-email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYourKeyHere\n-----END PRIVATE KEY-----\n"

# Firebase Client (Optional, used for password validation)
FIREBASE_API_KEY=your-api-key

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Email
# Render free web services block outbound SMTP ports 25, 465, and 587.
# For production on Render free, prefer Resend over SMTP.
RESEND_API_KEY=
EMAIL_FROM="LudusGen <noreply@your-verified-domain.com>"

# Email (SMTP fallback / local dev / paid Render)
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
EMAIL_SEND_TIMEOUT_MS=20000

# AI API Keys
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
OPENAI_API_KEY=
STABILITY_API_KEY=
MODELSCOPE_API_KEY=
DEAPI_API_KEY=
TRIPO3D_API_KEY=

# Storage (Backblaze B2)
B2_ENDPOINT=
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET_NAME=
B2_PUBLIC_URL=

# Frontend URL (for CORS)
FRONTEND_URL=https://your-app.netlify.app

# Security
MARKETPLACE_PURCHASE_SIGNING_SECRET=
